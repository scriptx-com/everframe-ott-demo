# Optional. Without these the app reports to the public Nocturne TV demo
# project on everframe.dev. Set them to send reports to your own project.
#
# SDK key of a React Native integration in Everframe (phones and TVs).
EXPO_PUBLIC_EVERFRAME_KEY=

# SDK key of a Web integration (the browser build). Falls back to the key above.
EXPO_PUBLIC_EVERFRAME_WEB_KEY=

# Backend calls go to an httpbin-compatible echo service so network logs carry
# real requests. Change it if httpbin.org is slow for you.
EXPO_PUBLIC_DEMO_API=https://httpbin.org
