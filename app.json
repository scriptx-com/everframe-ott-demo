{
  "expo": {
    "name": "Nocturne TV",
    "slug": "nocturne-demo",
    "version": "1.0.0",
    "scheme": "nocturne",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1B19",
    "newArchEnabled": true,
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1B19"
    },
    "ios": {
      "bundleIdentifier": "dev.everframe.nocturne",
      "supportsTablet": true,
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "dev.everframe.nocturne",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0E1B19"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon.png",
      "name": "Nocturne TV"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic",
            "deploymentTarget": "16.4"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BricolageCondensed-ExtraBold.ttf",
            "./assets/fonts/Bricolage-SemiBold.ttf",
            "./assets/fonts/Bricolage-Bold.ttf",
            "./assets/fonts/InstrumentSans-Regular.ttf",
            "./assets/fonts/InstrumentSans-Medium.ttf",
            "./assets/fonts/InstrumentSans-SemiBold.ttf"
          ]
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "tvosDeploymentTarget": "16.4",
          "androidTVBanner": "./assets/brand/tv-banner.png",
          "appleTVImages": {
            "icon": "./assets/brand/tv-icon-1280x768.png",
            "iconSmall": "./assets/brand/tv-icon-400x240.png",
            "iconSmall2x": "./assets/brand/tv-icon-800x480.png",
            "topShelf": "./assets/brand/tv-topshelf-1920x720.png",
            "topShelf2x": "./assets/brand/tv-topshelf-3840x1440.png",
            "topShelfWide": "./assets/brand/tv-topshelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/brand/tv-topshelf-wide-4640x1440.png"
          }
        }
      ],
      "./plugins/with-everframe-tv-prebuild.js",
      "./plugins/with-pod-deployment-target.js",
      "./plugins/with-scene-lifecycle.js"
    ]
  }
}
